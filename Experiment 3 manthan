```html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Grading System (Form Validation)</title>
  <style>
    body { font-family: Arial, sans-serif; background:#f5f7ff; margin:24px; }
    .card { max-width:520px; margin:auto; background:#fff; border:1px solid #e6e8ff; border-radius:14px; padding:16px; }
    h2 { margin:0 0 12px; font-size:18px; }
    label { display:block; margin:10px 0 6px; font-size:13px; color:#333; }
    input { width:100%; padding:10px; border-radius:10px; border:1px solid #d9dcef; }
    .row { display:flex; gap:10px; }
    .row > div { flex:1; }
    button { margin-top:12px; width:100%; padding:10px; border:none; border-radius:10px; background:#3b6cff; color:#fff; font-weight:700; cursor:pointer; }
    button:active { transform: translateY(1px); }
    .out { margin-top:12px; padding:12px; border-radius:10px; background:#0f172a; color:#e5e7eb; }
    .error { color:#ef4444; font-size:13px; margin-top:6px; }
    .ok { color:#34d399; font-size:13px; margin-top:6px; }
    .small { color:#a9b6d3; font-size:12px; margin-top:6px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Grading System</h2>

    <div class="row">
      <div>
        <label for="marks">Enter Marks (0 - 100)</label>
        <input id="marks" type="number" step="any" placeholder="e.g., 76" />
        <div id="err" class="error"></div>
      </div>
      <div>
        <label for="maxMarks">Max Marks</label>
        <input id="maxMarks" type="number" step="any" value="100" min="1" />
        <div id="err2" class="error"></div>
      </div>
    </div>

    <label for="gradeScale">Choose Grade Scale</label>
    <select id="gradeScale" style="width:100%;padding:10px;border-radius:10px;border:1px solid #d9dcef;">
      <option value="default" selected>Default (A/B/C/D/F)</option>
      <option value="simple">Simple (First/Second/Fail)</option>
    </select>

    <button id="btn" type="button">Calculate Grade</button>

    <div class="out">
      <div class="small" id="detail"></div>
      <div style="font-size:22px;font-weight:800;" id="result">—</div>
    </div>
  </div>

  <script>
    // Control structures + form validation + grade calculation

    const marksEl = document.getElementById("marks");
    const maxEl = document.getElementById("maxMarks");
    const scaleEl = document.getElementById("gradeScale");

    const errEl = document.getElementById("err");
    const err2El = document.getElementById("err2");

    const btn = document.getElementById("btn");
    const detailEl = document.getElementById("detail");
    const resultEl = document.getElementById("result");

    // Validation function
    function validateForm() {
      errEl.textContent = "";
      err2El.textContent = "";

      const marks = Number(marksEl.value);
      const maxMarks = Number(maxEl.value);

      // if-else validation
      if (Number.isNaN(marks)) {
        errEl.textContent = "Please enter marks as a number.";
        return { ok: false };
      }

      if (Number.isNaN(maxMarks)) {
        err2El.textContent = "Please enter max marks as a number.";
        return { ok: false };
      }

      if (maxMarks <= 0) {
        err2El.textContent = "Max marks must be greater than 0.";
        return { ok: false };
      }

      // Range validation
      if (marks < 0) {
        errEl.textContent = "Marks cannot be negative.";
        return { ok: false };
      }

      if (marks > maxMarks) {
        errEl.textContent = "Marks cannot be greater than max marks.";
        return { ok: false };
      }

      return { ok: true, marks, maxMarks };
    }

    // Grading (switch + if/else + loops)
    function getGrade(scorePercent, scale) {
      // Control structure: switch
      switch (scale) {
        case "default": {
          // Control structure: if/else chain
          if (scorePercent >= 90) return { grade: "A", remark: "Excellent" };
          else if (scorePercent >= 80) return { grade: "B", remark: "Very Good" };
          else if (scorePercent >= 70) return { grade: "C", remark: "Good" };
          else if (scorePercent >= 60) return { grade: "D", remark: "Pass" };
          else return { grade: "F", remark: "Fail" };
        }

        case "simple": {
          // Control structure: if/else chain
          if (scorePercent >= 75) return { grade: "First", remark: "Top performer" };
          else if (scorePercent >= 50) return { grade: "Second", remark: "Average" };
          else return { grade: "Fail", remark: "Needs improvement" };
        }

        default:
          return { grade: "—", remark: "Unknown scale" };
      }
    }

    // Extra control structure: loop (example: sample notes)
    function buildNotes(scale) {
      const notesDefault = [
        "Use 0 to max marks.",
        "Higher percentage means higher grade.",
        "This grader uses a simple threshold model."
      ];
      const notesSimple = [
        "First = 75%+",
        "Second = 50%+",
        "Fail = below 50%"
      ];

      const notes = (scale === "simple") ? notesSimple : notesDefault;

      // loop
      let text = "";
      for (let i = 0; i < notes.length; i++) {
        text += (i === 0 ? "" : " • ") + notes[i];
      }
      return text;
    }

    function calculateGrade() {
      const validation = validateForm();
      if (!validation.ok) {
        resultEl.textContent = "—";
        detailEl.textContent = "";
        return;
      }

      const { marks, maxMarks } = validation;

      // percentage
      const scorePercent = (marks / maxMarks) * 100;

      const scale = scaleEl.value;
      const { grade, remark } = getGrade(scorePercent, scale);

      // template literal
      resultEl.textContent = `${grade} (${remark})`;

      detailEl.textContent = `Marks: ${marks} / ${maxMarks}  |  Score: ${scorePercent.toFixed(2)}%  |  Scale: ${scale}`;
      console.log(`Calculated grade: ${grade}, score=${scorePercent.toFixed(2)}%`);
    }

    btn.addEventListener("click", calculateGrade);

    // Optional: live validation while typing
    [marksEl, maxEl].forEach(el => {
      el.addEventListener("input", () => {
        // Just re-check quickly for better UX (still uses same validation)
        errEl.textContent = "";
        err2El.textContent = "";
        resultEl.textContent = "—";
        detailEl.textContent = "";
        const v = validateForm();
        if (v.ok) {
          // small hint using loop-built notes
          detailEl.textContent = buildNotes(scaleEl.value);
        }
      });
    });
  </script>
</body>
</html>
