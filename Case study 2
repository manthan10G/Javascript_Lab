```html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Online Shopping - Bill Calculator</title>
  <style>
    :root{
      --bg:#f4f6ff;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#64748b;
      --border:#e5e7eb;
      --primary:#2563eb;
      --primary2:#1d4ed8;
      --danger:#dc2626;
      --success:#16a34a;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial;
      background: linear-gradient(180deg, #eef2ff, var(--bg));
      color:var(--text);
    }
    header{
      padding:22px 16px;
      text-align:center;
    }
    header h1{margin:0 0 6px; font-size:22px}
    header p{margin:0; color:var(--muted)}
    main{max-width:1100px; margin:0 auto; padding:16px}
    .grid{display:grid; grid-template-columns: 1.2fr .8fr; gap:16px}
    @media (max-width: 920px){ .grid{grid-template-columns:1fr} }

    section.card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:14px;
      padding:16px;
    }
    h2{margin:0 0 12px; font-size:16px}
    label{display:block; margin:10px 0 6px; font-size:13px; color:var(--muted)}
    input, select{
      width:100%;
      padding:10px 12px;
      border:1px solid var(--border);
      border-radius:10px;
      outline:none;
      font-size:14px;
      background:#fff;
    }
    input:focus, select:focus{
      border-color: rgba(37,99,235,.6);
      box-shadow: 0 0 0 3px rgba(37,99,235,.15);
    }

    .row{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    @media (max-width: 520px){ .row{grid-template-columns:1fr} }

    .btns{display:flex; gap:10px; margin-top:14px}
    button{
      border:none;
      border-radius:10px;
      padding:11px 14px;
      cursor:pointer;
      font-weight:700;
      font-size:14px;
      width:100%;
      background:var(--primary);
      color:#fff;
    }
    button:hover{background:var(--primary2)}
    .btn-secondary{background:#475569}
    .btn-secondary:hover{background:#334155}

    table{width:100%; border-collapse:collapse; margin-top:10px}
    th, td{padding:10px; border-bottom:1px solid var(--border); text-align:left; font-size:14px}
    th{color:var(--muted); font-weight:600}
    .summary{
      display:grid;
      gap:10px;
      margin-top:10px;
      padding:12px;
      background:#0b1220;
      border-radius:14px;
      color:#e5e7eb;
    }
    .summary .line{
      display:flex; justify-content:space-between; gap:10px;
      font-size:14px;
    }
    .summary .line strong{font-size:15px}
    .total{
      color:#34d399;
      font-size:18px;
      font-weight:900;
    }
    .err{
      margin-top:8px;
      color:var(--danger);
      font-size:13px;
      min-height:18px;
    }

    footer{
      text-align:center;
      padding:18px 16px;
      color:var(--muted);
      font-size:13px;
    }
  </style>
</head>

<body>
  <header>
    <h1>ShopNow Online Shopping</h1>
    <p>Enter customer & product details to calculate your bill.</p>
  </header>

  <main>
    <div class="grid">
      <!-- Customer + Product -->
      <section class="card">
        <h2>Customer & Order Details</h2>

        <!-- HTML5 tag usage: form, fieldset, legend -->
        <form id="orderForm">
          <fieldset style="border:1px solid var(--border); border-radius:12px; padding:12px;">
            <legend style="padding:0 8px; color:var(--muted); font-weight:700;">Customer</legend>

            <div class="row">
              <div>
                <label for="customerName">Customer Name</label>
                <input id="customerName" type="text" placeholder="e.g., Ali" required />
              </div>
              <div>
                <label for="mobile">Mobile Number</label>
                <input id="mobile" type="tel" placeholder="e.g., 9876543210" required maxlength="15" />
              </div>
            </div>
          </fieldset>

          <fieldset style="border:1px solid var(--border); border-radius:12px; padding:12px; margin-top:14px;">
            <legend style="padding:0 8px; color:var(--muted); font-weight:700;">Product & Billing</legend>

            <div class="row">
              <div>
                <label for="productName">Product Name</label>
                <input id="productName" type="text" placeholder="e.g., Headphones" required />
              </div>
              <div>
                <label for="quantity">Quantity</label>
                <input id="quantity" type="number" min="1" step="1" value="1" required />
              </div>
            </div>

            <div class="row">
              <div>
                <label for="price">Price per item</label>
                <input id="price" type="number" min="0" step="0.01" placeholder="e.g., 499.99" required />
              </div>
              <div>
                <label for="discount">Discount (Amount or %)</label>
                <!-- using select to interpret discount -->
                <div style="display:grid; grid-template-columns: 1fr 140px; gap:10px;">
                  <input id="discount" type="number" min="0" step="0.01" placeholder="e.g., 50 or 10" required />
                  <select id="discountType">
                    <option value="amount" selected>Amount</option>
                    <option value="percent">Percent</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="row">
              <div>
                <label for="gst">GST %</label>
                <input id="gst" type="number" min="0" step="0.01" placeholder="e.g., 18" required value="18" />
              </div>
              <div>
                <label for="discountNotes">Tip (Optional)</label>
                <input id="notes" type="text" placeholder="e.g., thank you!" />
              </div>
            </div>

            <div class="btns">
              <button type="button" id="calcBtn">Calculate Bill</button>
              <button type="button" class="btn-secondary" id="clearBtn">Clear</button>
            </div>

            <div id="error" class="err" role="alert"></div>
          </fieldset>
        </form>
      </section>

      <!-- Bill -->
      <aside class="card">
        <h2>Bill Summary</h2>

        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Customer</td><td id="sumCustomer">—</td></tr>
            <tr><td>Mobile</td><td id="sumMobile">—</td></tr>
            <tr><td>Product</td><td id="sumProduct">—</td></tr>
            <tr><td>Quantity</td><td id="sumQty">—</td></tr>
            <tr><td>Subtotal</td><td id="sumSubtotal">—</td></tr>
            <tr><td>Discount</td><td id="sumDiscount">—</td></tr>
            <tr><td>GST</td><td id="sumGst">—</td></tr>
          </tbody>
        </table>

        <div class="summary" aria-live="polite">
          <div class="line"><span>Total</span><strong class="total" id="sumTotal">—</strong></div>
          <div class="line" style="color:#cbd5e1;">
            <span>Final amount includes GST</span>
            <span id="sumGstRate"></span>
          </div>
        </div>

        <p class="err" id="calcErr" style="min-height:0;"></p>
      </aside>
    </div>
  </main>

  <footer>
    © ShopNow - Billing Calculator (HTML5 + CSS + JavaScript)
  </footer>

  <script>
    // Elements
    const customerNameEl = document.getElementById("customerName");
    const mobileEl = document.getElementById("mobile");
    const productNameEl = document.getElementById("productName");
    const quantityEl = document.getElementById("quantity");
    const priceEl = document.getElementById("price");
    const discountEl = document.getElementById("discount");
    const discountTypeEl = document.getElementById("discountType");
    const gstEl = document.getElementById("gst");

    const calcBtn = document.getElementById("calcBtn");
    const clearBtn = document.getElementById("clearBtn");
    const errorEl = document.getElementById("error");
    const calcErrEl = document.getElementById("calcErr");

    // Summary elements
    const sumCustomer = document.getElementById("sumCustomer");
    const sumMobile = document.getElementById("sumMobile");
    const sumProduct = document.getElementById("sumProduct");
    const sumQty = document.getElementById("sumQty");
    const sumSubtotal = document.getElementById("sumSubtotal");
    const sumDiscount = document.getElementById("sumDiscount");
    const sumGst = document.getElementById("sumGst");
    const sumTotal = document.getElementById("sumTotal");
    const sumGstRate = document.getElementById("sumGstRate");

    // Format helper
    const money = (n) => {
      const num = Number(n);
      if (!Number.isFinite(num)) return "—";
      return num.toFixed(2);
    };

    function validate() {
      errorEl.textContent = "";
      calcErrEl.textContent = "";

      const customerName = customerNameEl.value.trim();
      const mobile = mobileEl.value.trim();
      const productName = productNameEl.value.trim();

      const quantity = Number(quantityEl.value);
      const price = Number(priceEl.value);
      const discount = Number(discountEl.value);
      const gstPct = Number(gstEl.value);

      // Control validation (if/else)
      if (!customerName) return "Customer name is required.";
      if (!productName) return "Product name is required.";

      // simple mobile validation: digits length 7-15
      if (!/^\d{7,15}$/.test(mobile)) return "Enter a valid mobile number (7-15 digits).";

      if (!Number.isFinite(quantity) || quantity < 1) return "Quantity must be at least 1.";
      if (!Number.isFinite(price) || price < 0) return "Price per item must be 0 or more.";
      if (!Number.isFinite(discount) || discount < 0) return "Discount must be 0 or more.";
      if (!Number.isFinite(gstPct) || gstPct < 0) return "GST% must be 0 or more.";

      return null;
    }

    // Calculate using try/catch
    function calculateBill() {
      try {
        const err = validate();
        if (err) {
          errorEl.textContent = err;
          return;
        }

        const customerName = customerNameEl.value.trim();
        const mobile = mobileEl.value.trim();
        const productName = productNameEl.value.trim();

        const quantity = Number(quantityEl.value);
        const price = Number(priceEl.value);
        const discount = Number(discountEl.value);
        const gstPct = Number(gstEl.value);

        const discountType = discountTypeEl.value;

        // Subtotal
        const subtotal = quantity * price;

        // Discount amount
        let discountAmount = 0;
        if (discountType === "percent") {
          discountAmount = subtotal * (discount / 100);
        } else {
          discountAmount = discount; // amount
        }

        // Prevent discount > subtotal
        if (discountAmount > subtotal) discountAmount = subtotal;

        const afterDiscount = subtotal - discountAmount;

        // GST amount
        const gstAmount = afterDiscount * (gstPct / 100);

        // Total
        const total = afterDiscount + gstAmount;

        // Update UI
        sumCustomer.textContent = customerName;
        sumMobile.textContent = mobile;
        sumProduct.textContent = productName;
        sumQty.textContent = quantity;

        sumSubtotal.textContent = money(subtotal);
        sumDiscount.textContent = money(discountAmount);
        sumGst.textContent = money(gstAmount);

        sumGstRate.textContent = `GST Rate: ${gstPct}%`;

        sumTotal.textContent = money(total);

        // small console output
        console.log("Bill calculated:", { subtotal, discountAmount, gstAmount, total });
      } catch (e) {
        errorEl.textContent = "Something went wrong. Please check your input.";
        console.error(e);
      }
    }

    function clearAll() {
      errorEl.textContent = "";
      calcErrEl.textContent = "";

      customerNameEl.value = "";
      mobileEl.value = "";
      productNameEl.value = "";
      quantityEl.value = 1;
      priceEl.value = "";
      discountEl.value = "";
      discountTypeEl.value = "amount";
      gstEl.value = 18;

      sumCustomer.textContent = "—";
      sumMobile.textContent = "—";
      sumProduct.textContent = "—";
      sumQty.textContent = "—";
      sumSubtotal.textContent = "—";
      sumDiscount.textContent = "—";
      sumGst.textContent = "—";
      sumGstRate.textContent = "";
      sumTotal.textContent = "—";
    }

    calcBtn.addEventListener("click", calculateBill);
    clearBtn.addEventListener("click", clearAll);
  </script>
</body>
</html>
