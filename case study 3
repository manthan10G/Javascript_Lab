Here’s a simple JavaScript program that accepts student marks and displays the scholarship category.

```html
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Scholarship Category</title>
</head>
<body>
  <h3>Scholarship Category Calculator</h3>

  <label>Enter marks (0 - 100): </label>
  <input type="number" id="marks" min="0" max="100" />
  <button onclick="getCategory()">Check</button>

  <p id="result"></p>

  <script>
    function getCategory() {
      const marks = Number(document.getElementById("marks").value);
      const result = document.getElementById("result");

      if (Number.isNaN(marks)) {
        result.textContent = "Please enter valid marks.";
        return;
      }
      if (marks < 0 || marks > 100) {
        result.textContent = "Marks must be between 0 and 100.";
        return;
      }

      let category;

      // Scholarship categories (you can change these rules)
      if (marks >= 90) category = "Gold Scholarship";
      else if (marks >= 75) category = "Silver Scholarship";
      else if (marks >= 60) category = "Bronze Scholarship";
      else category = "No Scholarship";

      result.textContent = `Scholarship Category: ${category}`;
    }
  </script>
</body>
</html>
```

