<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>User Info + Welcome</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      margin: 0;
      padding: 24px;
      color: #111;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
    }

    .card {
      background: #fff;
      border: 1px solid #e6e8ef;
      border-radius: 12px;
      padding: 18px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.05);
    }

    h1 {
      font-size: 20px;
      margin: 0 0 12px;
    }

    .grid {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 10px 14px;
      align-items: center;
      margin-bottom: 14px;
    }

    label {
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d7dbe6;
      border-radius: 10px;
      outline: none;
      background: #fff;
    }

    input:focus {
      border-color: #5b7cfa;
      box-shadow: 0 0 0 3px rgba(91,124,250,0.15);
    }

    .message {
      margin-top: 14px;
      padding: 14px;
      border-radius: 10px;
      background: #0b1220;
      color: #d7f7e6;
      border: 1px solid rgba(215,247,230,0.25);
    }

    .message strong {
      color: #7CFFB2;
    }

    .hint {
      margin-top: 10px;
      font-size: 14px;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>User Info</h1>

      <div class="grid">
        <label for="name">Name</label>
        <input id="name" type="text" placeholder="e.g., Alex" />

        <label for="age">Age</label>
        <input id="age" type="number" placeholder="e.g., 25" />

        <label for="city">City</label>
        <input id="city" type="text" placeholder="e.g., London" />
      </div>

      <div class="message">
        <div><strong>Welcome!</strong> <span id="welcomeText">Guest</span></div>
        <div class="hint">(This welcome text area is static—add JS if you want it to change.)</div>
      </div>
    </div>
  </div>
</body>
</html>
