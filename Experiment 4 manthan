<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Palindrome Checker (try/catch + closures)</title>
  <style>
    body{font-family:Arial,sans-serif;background:#f5f7ff;margin:24px}
    .card{max-width:520px;margin:auto;background:#fff;border:1px solid #e6e8ff;border-radius:14px;padding:16px}
    h2{margin:0 0 12px;font-size:18px}
    label{display:block;margin:10px 0 6px;font-size:13px;color:#333}
    input{width:100%;padding:10px;border-radius:10px;border:1px solid #d9dcef}
    button{margin-top:12px;width:100%;padding:10px;border:none;border-radius:10px;background:#3b6cff;color:#fff;font-weight:700;cursor:pointer}
    button:active{transform:translateY(1px)}
    .out{margin-top:12px;padding:12px;border-radius:10px;background:#0f172a;color:#e5e7eb}
    .small{color:#a9b6d3;font-size:12px;margin-top:8px}
  </style>
</head>
<body>
  <div class="card">
    <h2>Palindrome Checker</h2>

    <label for="text">Enter text</label>
    <input id="text" type="text" placeholder="e.g., racecar" />

    <button id="checkBtn" type="button">Check Palindrome</button>

    <div class="out">
      <div id="result" style="font-size:20px;font-weight:800;">—</div>
      <div id="meta" class="small"></div>
    </div>
  </div>

  <script>
    // function types: declaration + expression + arrow (used below)
    function normalize(str) {
      // remove spaces + punctuation, lowercase
      return str.toLowerCase().replace(/[^a-z0-9]/g, "");
    }

    const isPalindrome = function (s) { // function expression
      let i = 0;
      let j = s.length - 1;
      while (i < j) {
        if (s[i] !== s[j]) return false;
        i++;
        j--;
      }
      return true;
    };

    const formatAnswer = (ok, original, cleaned) => { // arrow function
      // template literal
      return `${ok ? "Palindrome ✅" : "Not a palindrome ❌"}<br/>Input: "${original}"<br/>Normalized: "${cleaned}"`;
    };

    // closures + scope:
    // create a checker factory that remembers how many checks were done
    function createPalindromeChecker() {
      let count = 0; // captured by the returned function (closure)

      return function check() { // inner function closes over "count"
        count += 1;

        const inputEl = document.getElementById("text");
        const original = inputEl.value;

        try {
          // try/catch: force an error if input is empty after trimming
          if (!original || original.trim().length === 0) {
            throw new Error("Empty input");
          }

          const cleaned = normalize(original);
          const ok = isPalindrome(cleaned);

          const resultEl = document.getElementById("result");
          const metaEl = document.getElementById("meta");

          resultEl.innerHTML = formatAnswer(ok, original, cleaned);
          metaEl.textContent = `Checks done (closure count): ${count}`;
        } catch (err) {
          document.getElementById("result").textContent = "—";
          document.getElementById("meta").textContent = `Error: ${err.message}. Please enter some text.`;
        }
      };
    }

    // Use the closure
    const check = createPalindromeChecker();

    document.getElementById("checkBtn").addEventListener("click", check);
  </script>
</body>
</html>
