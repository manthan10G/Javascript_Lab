<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Bill (Billing) Calculator</title>
  <style>
    body{font-family:Arial,sans-serif;background:#f5f7ff;margin:24px}
    .card{max-width:520px;margin:auto;background:#fff;border:1px solid #e6e8ff;border-radius:14px;padding:16px}
    h2{margin:0 0 12px;font-size:18px}
    label{display:block;margin:10px 0 6px;font-size:13px;color:#333}
    input,select{width:100%;padding:10px;border-radius:10px;border:1px solid #d9dcef}
    .row{display:flex;gap:10px}
    .row > div{flex:1}
    button{margin-top:12px;width:100%;padding:10px;border:none;border-radius:10px;background:#3b6cff;color:#fff;font-weight:700;cursor:pointer}
    button:active{transform:translateY(1px)}
    .out{margin-top:12px;padding:12px;border-radius:10px;background:#0f172a;color:#e5e7eb}
    .small{color:#a9b6d3;font-size:12px;margin-bottom:6px}
  </style>
</head>
<body>
  <div class="card">
    <h2>Bill (Billing) Calculator</h2>

    <div class="row">
      <div>
        <label for="items">Items total</label>
        <input id="items" type="number" step="any" placeholder="e.g., 120">
      </div>
      <div>
        <label for="tax">Tax %</label>
        <input id="tax" type="number" step="any" placeholder="e.g., 10">
      </div>
    </div>

    <label for="tip">Tip %</label>
    <input id="tip" type="number" step="any" placeholder="e.g., 5">

    <label for="people">Split bill between (people)</label>
    <select id="people">
      <option value="1" selected>1 person</option>
      <option value="2">2 people</option>
      <option value="3">3 people</option>
      <option value="4">4 people</option>
      <option value="5">5 people</option>
      <option value="6">6 people</option>
    </select>

    <button id="calcBtn" type="button">Calculate Bill</button>

    <div class="out">
      <div class="small" id="eq"></div>
      <div style="font-size:22px;font-weight:800" id="result">—</div>
      <div id="detail" style="margin-top:6px;color:#d1d5db;font-size:13px"></div>
    </div>
  </div>

  <script>
    // var / let / const demo
    var appName = "billing-calculator";
    let clickCount = 0;
    const UI = {
      invalid: "Enter valid numbers.",
      divideZero: "Number of people cannot be 0.",
      total: "Total",
      perPerson: "Per person"
    };

    const itemsEl = document.getElementById("items");
    const taxEl = document.getElementById("tax");
    const tipEl = document.getElementById("tip");
    const peopleEl = document.getElementById("people");

    const calcBtn = document.getElementById("calcBtn");
    const eqEl = document.getElementById("eq");
    const resultEl = document.getElementById("result");
    const detailEl = document.getElementById("detail");

    function readInputs() {
      // Destructuring + basic parsing
      const data = {
        items: Number(itemsEl.value),
        taxPct: Number(taxEl.value),
        tipPct: Number(tipEl.value),
        people: Number(peopleEl.value)
      };
      const { items, taxPct, tipPct, people } = data; // destructuring assignment
      return { items, taxPct, tipPct, people };
    }

    function calculate() {
      clickCount += 1;
      const { items, taxPct, tipPct, people } = readInputs();

      if ([items, taxPct, tipPct, people].some(n => Number.isNaN(n))) {
        resultEl.textContent = "—";
        detailEl.textContent = UI.invalid;
        eqEl.textContent = "";
        return;
      }

      if (people === 0) {
        resultEl.textContent = "—";
        detailEl.textContent = UI.divideZero;
        eqEl.textContent = "";
        return;
      }

      const taxAmt = items * (taxPct / 100);
      const tipAmt = items * (tipPct / 100);
      const total = items + taxAmt + tipAmt;
      const perPerson = total / people;

      // Template literals
      eqEl.textContent = `${items} + (${taxPct}% of ${items}) + (${tipPct}% of ${items})`;
      resultEl.textContent = `${UI.total}: ${total.toFixed(2)}`;
      detailEl.textContent = `${UI.perPerson}: ${perPerson.toFixed(2)}  (calc #${clickCount})`;

      console.log(`${appName}: calc #${clickCount}`);
      console.table([{ items, taxPct, tipPct, people, taxAmt, tipAmt, total, perPerson }]);
    }

    calcBtn.addEventListener("click", calculate);
  </script>
</body>
</html>
