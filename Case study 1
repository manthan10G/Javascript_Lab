```html
<!-- student.html (Student Information Page) -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Student Information - SIT Nagpur</title>
  <style>
    body{font-family:Arial,sans-serif;background:#f5f7ff;margin:24px;color:#0f172a}
    .card{max-width:760px;margin:auto;background:#fff;border:1px solid #e6e8ff;border-radius:14px;padding:16px}
    h1{margin:0 0 8px;font-size:22px}
    p{margin:0 0 14px;color:#475569}
    table{width:100%;border-collapse:collapse}
    th,td{border-bottom:1px solid #e6e8ff;padding:10px;text-align:left}
    th{color:#475569}
    .back{display:inline-block;margin-top:12px;color:#2563eb;text-decoration:none;font-weight:700}
  </style>
</head>
<body>
  <div class="card">
    <h1>Student Information</h1>
    <p>Sample student list (you can replace with real data).</p>

    <table>
      <thead>
        <tr>
          <th>Student Name</th>
          <th>Roll No</th>
          <th>Department</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Ali</td>
